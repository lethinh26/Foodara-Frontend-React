# ============================================
# FOODARA — Environment Configuration
# ============================================

# ── API Configuration ──
VITE_API_BASE_URL=http://localhost:8080/api
VITE_MOCK_MODE=false

# ── Map Provider (Mapbox) ──
VITE_MAPBOX_TOKEN=
VITE_MAP_STYLE=mapbox://styles/mapbox/streets-v12

# ── Default Map Center (Ho Chi Minh City) ──
VITE_DEFAULT_LAT=10.8231
VITE_DEFAULT_LNG=106.6297

# ── Payment Provider ──
VITE_PAYMENT_PROVIDER_KEY=

# ── Feature Flags ──
VITE_FEATURE_REALTIME=false
VITE_FEATURE_ANALYTICS=false

# ── Analytics ──
VITE_ANALYTICS_KEY=
